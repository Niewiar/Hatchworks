[gd_scene format=3]
[ext_resource type="Script" path="res://addons/hatchworks_database/discovery_recipes.gd" id="script"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/recipe_editor.tscn" id="editor"]

[node name="DiscoveryRecipes" type="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10
script = ExtResource("script")

[node name="Heading" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Heading"]
layout_mode = 2
size_flags_horizontal = 3
text = "Recipes"
theme_override_font_sizes/font_size = 17

[node name="Add" type="Button" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
text = "+ Recipe"

[node name="Links" type="Tree" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0,120)
layout_mode = 2
hide_root = true

[node name="Empty" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "No recipes yet. Add a combination for this discovery."
autowrap_mode = 3

[node name="InlineRecipe" parent="." instance=ExtResource("editor")]
unique_name_in_owner = true
layout_mode = 2
visible = false

[node name="ScienceRow" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
visible = false

[node name="Label" type="Label" parent="ScienceRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Science reward"

[node name="Science" type="SpinBox" parent="ScienceRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110,0)
layout_mode = 2
min_value = 0.0
max_value = 1000.0
step = 1.0
