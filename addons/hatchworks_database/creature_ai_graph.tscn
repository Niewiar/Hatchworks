[gd_scene format=3]
[ext_resource type="Script" path="res://addons/hatchworks_database/creature_ai_graph.gd" id="script"]
[node name="CreatureAiGraphEditor" type="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 12
script = ExtResource("script")
[node name="Toolbar" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12
[node name="Title" type="Label" parent="Toolbar"]
layout_mode = 2
text = "CREATURE AI"
[node name="Species" type="OptionButton" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/icon_max_width = 24

[node name="Fit" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Fit graph"
[node name="Reset" type="Button" parent="Toolbar"]
unique_name_in_owner = true
layout_mode = 2
text = "Restore default rules"
[node name="Help" type="Label" parent="."]
layout_mode = 2
text = "Connect states, select a transition and edit its conditions. Higher priorities run first. If an action is unavailable, the next matching rule is tried. Existing movement, work animations, safe landings and breeding stay automatic. Save All applies these rules when gameplay restarts."
autowrap_mode = 3
[node name="Body" type="HSplitContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
[node name="Graph" type="GraphEdit" parent="Body"]
unique_name_in_owner = true
custom_minimum_size = Vector2(300, 320)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
right_disconnects = true
[node name="Settings" type="ScrollContainer" parent="Body"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2
horizontal_scroll_mode = 0
[node name="Content" type="VBoxContainer" parent="Body/Settings"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12
[node name="Title" type="Label" parent="Body/Settings/Content"]
layout_mode = 2
text = "TRANSITIONS"
[node name="Transitions" type="OptionButton" parent="Body/Settings/Content"]
unique_name_in_owner = true
layout_mode = 2
fit_to_longest_item = false
[node name="AddTransition" type="Button" parent="Body/Settings/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Add transition"
[node name="EdgeFields" type="VBoxContainer" parent="Body/Settings/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="FromLabel" type="Label" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
text = "From state"

[node name="From" type="OptionButton" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
fit_to_longest_item = false

[node name="ToLabel" type="Label" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
text = "To state"

[node name="To" type="OptionButton" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
fit_to_longest_item = false

[node name="PriorityLabel" type="Label" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
text = "Priority (higher first)"

[node name="Priority" type="SpinBox" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
min_value = -1000.0
max_value = 1000.0

[node name="Match" type="OptionButton" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
popup/item_0/text = "All conditions (AND)"
popup/item_0/id = 0
popup/item_1/text = "Any condition (OR)"
popup/item_1/id = 1

[node name="Conditions" type="VBoxContainer" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="AddCondition" type="Button" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
text = "Add condition"

[node name="RemoveTransition" type="Button" parent="Body/Settings/Content/EdgeFields"]
unique_name_in_owner = true
layout_mode = 2
text = "Remove transition"

[node name="Note" type="Label" parent="Body/Settings/Content"]
layout_mode = 2
text = "Boolean conditions: 1 = true, 0 = false. Empty conditions always match. Eat can interrupt work or rest; completed action effects and mandatory cooldowns remain protected."
autowrap_mode = 3
