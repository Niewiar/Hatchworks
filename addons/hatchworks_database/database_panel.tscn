[gd_scene format=3]
[ext_resource type="Script" path="res://addons/hatchworks_database/database_panel.gd" id="script"]
[ext_resource type="Theme" path="res://addons/hatchworks_database/studio_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/database_preview.tscn" id="preview"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/recipe_editor.tscn" id="recipe_editor"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/discovery_recipes.tscn" id="discovery_recipes"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/discovery_graph.tscn" id="discovery_graph"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/studio_web_button.tscn" id="web"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/design_document.tscn" id="design"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_database/creature_ai_graph.tscn" id="ai_graph"]
[sub_resource type="StyleBoxFlat" id="Background"]
bg_color = Color(0.067,0.09,0.078,1)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_left = 0
corner_radius_bottom_right = 0
content_margin_left = 18.0
content_margin_top = 18.0
content_margin_right = 18.0
content_margin_bottom = 18.0

[sub_resource type="ButtonGroup" id="Sections"]
[sub_resource type="SystemFont" id="TitleFont"]
font_names = PackedStringArray("Georgia")
[node name="DatabasePanel" type="PanelContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("theme")
theme_override_styles/panel = SubResource("Background")
script = ExtResource("script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="HBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="Brand" type="VBoxContainer" parent="Layout/Header"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 2

[node name="Title" type="Label" parent="Layout/Header/Brand"]
layout_mode = 2
text = "HATCHWORKS"
theme_override_font_sizes/font_size = 20

[node name="Subtitle" type="Label" parent="Layout/Header/Brand"]
layout_mode = 2
text = "WORLD STUDIO"
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.57,0.65,0.51,1)

[node name="Navigation" type="HFlowContainer" parent="Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6

[node name="CreaturesTab" type="Button" parent="Layout/Header/Navigation"]
unique_name_in_owner = true
layout_mode = 2
text = "Creatures"
toggle_mode = true
button_group = SubResource("Sections")
button_pressed = true

[node name="DiscoveriesTab" type="Button" parent="Layout/Header/Navigation"]
unique_name_in_owner = true
layout_mode = 2
text = "Discoveries"
toggle_mode = true
button_group = SubResource("Sections")

[node name="DatabaseTab" type="Button" parent="Layout/Header/Navigation"]
unique_name_in_owner = true
layout_mode = 2
