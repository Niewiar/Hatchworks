[gd_scene format=3]

[ext_resource type="Script" path="res://addons/hatchworks_database/discovery_graph.gd" id="1"]

[node name="DiscoveryGraph" type="VBoxContainer"]
custom_minimum_size = Vector2(280,0)
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 8
script = ExtResource("1")

[node name="Actions" type="HFlowContainer" parent="."]
layout_mode = 2

[node name="NewDiscovery" type="Button" parent="Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "+ Discovery"

[node name="NewRecipe" type="Button" parent="Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "+ Recipe"

[node name="ShowAll" type="Button" parent="Actions"]
unique_name_in_owner = true
layout_mode = 2
toggle_mode = true
text = "All discoveries"

[node name="Arrange" type="Button" parent="Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Arrange"

[node name="Fit" type="Button" parent="Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Fit"

[node name="Find" type="LineEdit" parent="."]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Find a discovery and its connections…"

[node name="Graph" type="GraphEdit" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(260, 300)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
right_disconnects = false
show_arrange_button = false
zoom = 0.7
connection_lines_thickness = 2.0
minimap_enabled = false

[node name="Help" type="Label" parent="."]
layout_mode = 2
autowrap_mode = 3
text = "Choose a discovery. Edit its A + B → result recipes in the side panel."
theme_override_font_sizes/font_size = 12

[node name="GraphCount" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
