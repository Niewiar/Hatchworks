[gd_scene format=3]
[ext_resource type="Script" path="res://addons/hatchworks_database/database_preview.gd" id="script"]
[sub_resource type="Environment" id="Environment"]
background_mode = 1
background_color = Color(0.09,0.13,0.098,1)
ambient_light_source = 2
ambient_light_energy = 0.75
[sub_resource type="StyleBoxFlat" id="Frame"]
bg_color = Color(0.09,0.13,0.098,1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
