light_color = Color(0.6,0.8,0.66,1)
light_energy = 0.4

[node name="Models" type="Node3D" parent="Layout/Stage/Viewport"]
unique_name_in_owner = true


[node name="Camera" type="Camera3D" parent="Layout/Stage/Viewport"]
unique_name_in_owner = true
projection = 1
current = true
size = 3.0

[node name="IconCenter" type="CenterContainer" parent="Layout/Stage"]
