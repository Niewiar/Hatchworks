corner_radius_top_right = 14
corner_radius_bottom_left = 14
corner_radius_bottom_right = 14
content_margin_left = 12.0
content_margin_top = 12.0
content_margin_right = 12.0
content_margin_bottom = 12.0

[node name="Preview" type="PanelContainer"]
custom_minimum_size = Vector2(0,320)
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_styles/panel = SubResource("Frame")
script = ExtResource("script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Controls" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="SexControls" type="HBoxContainer" parent="Layout/Controls"]
unique_name_in_owner = true
layout_mode = 2

[node name="Male" type="Button" parent="Layout/Controls/SexControls"]
