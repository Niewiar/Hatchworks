layout_mode = 2
text = "♀ Female"
toggle_mode = true
button_pressed = false

[node name="Spacer" type="Control" parent="Layout/Controls"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="ResetView" type="Button" parent="Layout/Controls"]
unique_name_in_owner = true
layout_mode = 2
text = "Reset view"

[node name="Stage" type="SubViewportContainer" parent="Layout"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(0,200)
stretch = true
mouse_filter = 0

[node name="Viewport" type="SubViewport" parent="Layout/Stage"]
own_world_3d = true
size = Vector2i(420,300)
render_target_update_mode = 4

[node name="Environment" type="WorldEnvironment" parent="Layout/Stage/Viewport"]
environment = SubResource("Environment")

[node name="Key" type="DirectionalLight3D" parent="Layout/Stage/Viewport"]
