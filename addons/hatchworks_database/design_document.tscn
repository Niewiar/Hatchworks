[gd_scene format=3]
[ext_resource type="Script" path="res://addons/hatchworks_database/design_document.gd" id="script"]
[node name="DesignDoc" type="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
size_flags_horizontal = 3
theme_override_constants/separation = 12
script = ExtResource("script")

[node name="Heading" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Heading"]
layout_mode = 2
text = "Design Doc"
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 28

[node name="State" type="Label" parent="Heading"]
unique_name_in_owner = true
layout_mode = 2
text = "Saved"

[node name="Note" type="Label" parent="."]
layout_mode = 2
text = "One shared project document. Design notes do not change gameplay parameters."
autowrap_mode = 3

[node name="Conflict" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
visible = false
autowrap_mode = 3
text = "Saved text changed in the other editor. Your draft is preserved. Copy any passages you need before reloading."
theme_override_colors/font_color = Color(0.9,0.76,0.43,1)

[node name="Views" type="TabContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="Write" type="MarginContainer" parent="Views"]
layout_mode = 2
theme_override_constants/margin_top = 12

[node name="Source" type="TextEdit" parent="Views/Write"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
wrap_mode = 1
context_menu_enabled = true
theme_override_font_sizes/font_size = 15

[node name="Read" type="MarginContainer" parent="Views"]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_right = 22
theme_override_constants/margin_top = 18
theme_override_constants/margin_bottom = 18

[node name="Preview" type="RichTextLabel" parent="Views/Read"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
selection_enabled = true
bbcode_enabled = true
scroll_active = true
theme_override_font_sizes/normal_font_size = 16

[node name="Footer" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Status" type="Label" parent="Footer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
autowrap_mode = 3
text = "Shared project document"

[node name="Reload" type="Button" parent="Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Reload saved"

[node name="Save" type="Button" parent="Footer"]
unique_name_in_owner = true
layout_mode = 2
text = "Save document"
theme_type_variation = &"PrimaryButton"

[node name="Poll" type="Timer" parent="."]
unique_name_in_owner = true
wait_time = 2.0
autostart = true

[node name="DiscardDialog" type="ConfirmationDialog" parent="."]
unique_name_in_owner = true
title = "Reload Design Doc"
dialog_text = "Reload the saved document and discard this draft?"

