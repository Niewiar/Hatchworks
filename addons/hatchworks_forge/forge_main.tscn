[gd_scene format=3]

[ext_resource type="Script" path="res://addons/hatchworks_forge/forge_main.gd" id="script"]
[ext_resource type="Theme" path="res://addons/hatchworks_forge/forge_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_forge/discoveries/discovery_panel.tscn" id="discoveries"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_forge/creatures/creature_panel.tscn" id="creatures"]

[node name="HatchworksForge" type="PanelContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("theme")
theme_type_variation = &"ForgeMain"
script = ExtResource("script")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"ForgeTitle"
text = "Hatchworks Forge"

[node name="Project" type="Label" parent="Content/Header"]
layout_mode = 2
theme_type_variation = &"ForgeMuted"
text = "Narzędzia projektu"

[node name="Sections" type="TabContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3
current_tab = 0

[node name="Discoveries" parent="Content/Sections" instance=ExtResource("discoveries")]
unique_name_in_owner = true
layout_mode = 2

[node name="Creatures" parent="Content/Sections" instance=ExtResource("creatures")]
unique_name_in_owner = true
layout_mode = 2
