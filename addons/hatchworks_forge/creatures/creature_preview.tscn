ambient_light_source = 3
ambient_light_color = Color(0.77, 0.84, 0.74, 1)
ambient_light_energy = 0.8
reflected_light_source = 2
tonemap_mode = 0

[sub_resource type="StandardMaterial3D" id="GridMaterial"]
