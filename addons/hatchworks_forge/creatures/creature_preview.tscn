[gd_scene format=3]

[ext_resource type="Script" path="res://addons/hatchworks_forge/creatures/creature_preview.gd" id="script"]

[sub_resource type="ButtonGroup" id="ViewGroup"]
allow_unpress = true

[sub_resource type="StyleBoxFlat" id="PreviewSurface"]
bg_color = Color(0.105, 0.16, 0.125, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
