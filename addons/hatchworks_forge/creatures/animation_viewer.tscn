[gd_scene format=3]

[ext_resource type="Script" path="res://addons/hatchworks_forge/creatures/animation_viewer.gd" id="script"]
[ext_resource type="Theme" path="res://addons/hatchworks_forge/forge_theme.tres" id="theme"]
[ext_resource type="PackedScene" path="res://addons/hatchworks_forge/creatures/creature_preview.tscn" id="preview"]

[sub_resource type="ButtonGroup" id="sex"]

[node name="HatchworksAnimationViewer" type="Window"]
title = "Hatchworks Animation Viewer"
initial_position = 1
size = Vector2i(1440, 900)
min_size = Vector2i(1100, 720)
visible = false
force_native = true
transient = true
script = ExtResource("script")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
theme_type_variation = &"ForgeMain"

[node name="Margins" type="MarginContainer" parent="Panel"]
