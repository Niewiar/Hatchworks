[gd_scene format=3]

[node name="MappingRow" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 3

[node name="ValueRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Name" type="Label" parent="ValueRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Wpis"
autowrap_mode = 3

[node name="Percent" type="SpinBox" parent="ValueRow"]
custom_minimum_size = Vector2(112, 0)
layout_mode = 2
max_value = 100.0
step = 0.1
allow_greater = true
allow_lesser = true
suffix = "%"

[node name="Remove" type="Button" parent="ValueRow"]
visible = false
layout_mode = 2
text = "Usuń"

[node name="Note" type="Label" parent="."]
visible = false
layout_mode = 2
theme_type_variation = &"ForgeMuted"
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
