[gd_scene format=3]

[ext_resource type="Script" path="res://addons/hatchworks_forge/creatures/mapping_editor.gd" id="script"]

[node name="MappingEditor" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 8
script = ExtResource("script")

[node name="Override" type="CheckButton" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Osobny profil samicy"

[node name="Inheritance" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ForgeMuted"
theme_override_font_sizes/font_size = 12
text = "Wyłącz osobny profil, aby używać ustawień wspólnych."
autowrap_mode = 3

[node name="Inherited" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
autowrap_mode = 3

[node name="Rows" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 8

[node name="Total" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ForgeMuted"
theme_override_font_sizes/font_size = 12
autowrap_mode = 3

[node name="Repair" type="VBoxContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 6

[node name="Reason" type="Label" parent="Repair"]
layout_mode = 2
theme_type_variation = &"ForgeError"
text = "Zachowano nieprawidłowy szkic. Popraw zapis poniżej, aby wrócić do tabeli."
autowrap_mode = 3

[node name="Raw" type="TextEdit" parent="Repair"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_horizontal = 3
wrap_mode = 1

[node name="ApplyRepair" type="Button" parent="Repair"]
unique_name_in_owner = true
layout_mode = 2
text = "Zastosuj poprawiony zapis"

[node name="Error" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"ForgeError"
autowrap_mode = 3
