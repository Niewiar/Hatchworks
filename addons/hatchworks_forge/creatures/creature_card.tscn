[gd_scene format=3]

[node name="CreatureCard" type="Button"]
custom_minimum_size = Vector2(0, 92)
size_flags_horizontal = 3
toggle_mode = true
theme_type_variation = &"CreatureCard"

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 9
theme_override_constants/margin_top = 9
theme_override_constants/margin_right = 9
theme_override_constants/margin_bottom = 9

[node name="Content" type="HBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 12

[node name="Portrait" type="TextureRect" parent="Margin/Content"]
custom_minimum_size = Vector2(66, 72)
layout_mode = 2
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Info" type="VBoxContainer" parent="Margin/Content"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2

[node name="Name" type="Label" parent="Margin/Content/Info"]
layout_mode = 2
mouse_filter = 2
text = "Kreatura"
text_overrun_behavior = 3

[node name="Id" type="Label" parent="Margin/Content/Info"]
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"CreatureMuted"
text = "gatunek"
text_overrun_behavior = 3
