[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://addons/atlas_creator/atlas_creator_window.gd" id="1_window"]

[ext_resource type="Theme" path="res://addons/atlas_creator/atlas_creator_theme.tres" id="2_theme"]

[node name="AtlasCreatorWindow" type="Window"]
auto_translate_mode = 2
title = "Atlas Creator"
size = Vector2i(820, 700)
visible = false
transient = true
min_size = Vector2i(660, 600)
theme = ExtResource("2_theme")
script = ExtResource("1_window")

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0, 0, 0, 1)

[node name="Layout" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Content" type="VBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SourceLabel" type="Label" parent="Layout/Content"]
layout_mode = 2
text = "Source texture"

[node name="SourceRow" type="HBoxContainer" parent="Layout/Content"]
layout_mode = 2

[node name="PathField" type="LineEdit" parent="Layout/Content/SourceRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Choose a PNG, WebP or JPEG texture sheet…"
editable = false

[node name="Browse" type="Button" parent="Layout/Content/SourceRow"]
layout_mode = 2
text = "Browse…"

[node name="Fields" type="GridContainer" parent="Layout/Content"]
layout_mode = 2
theme_override_constants/h_separation = 12
theme_override_constants/v_separation = 8
columns = 4

[node name="WidthLabel" type="Label" parent="Layout/Content/Fields"]
layout_mode = 2
text = "Tile width (px)"

[node name="TileWidth" type="SpinBox" parent="Layout/Content/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 16384.0
value = 128.0

[node name="HeightLabel" type="Label" parent="Layout/Content/Fields"]
layout_mode = 2
text = "Tile height (px)"

[node name="TileHeight" type="SpinBox" parent="Layout/Content/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_horizontal = 3
min_value = 1.0
max_value = 16384.0
value = 128.0

[node name="GapLabel" type="Label" parent="Layout/Content/Fields"]
layout_mode = 2
text = "Tile spacing (px)"

[node name="Gap" type="SpinBox" parent="Layout/Content/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_horizontal = 3
max_value = 16384.0
value = 1.0

[node name="MarginLabel" type="Label" parent="Layout/Content/Fields"]
layout_mode = 2
text = "Outer margin (px)"

[node name="Margin" type="SpinBox" parent="Layout/Content/Fields"]
unique_name_in_owner = true
custom_minimum_size = Vector2(90, 0)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Equal margin on all four sides of the image, in pixels. Usually 0 for PixelLab sheets."
max_value = 16384.0

[node name="FormatRow" type="HBoxContainer" parent="Layout/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="FormatLabel" type="Label" parent="Layout/Content/FormatRow"]
layout_mode = 2
text = "Output format"

[node name="Format" type="OptionButton" parent="Layout/Content/FormatRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
item_count = 2
selected = 0
popup/item_0/text = "Texture2DArray (.res)"
popup/item_0/id = 0
popup/item_1/text = "Packed PNG atlas (.png)"
popup/item_1/id = 1

[node name="Summary" type="Label" parent="Layout/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Choose a texture to inspect its tile grid."
autowrap_mode = 3

[node name="Previews" type="HBoxContainer" parent="Layout/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 16

[node name="SourceColumn" type="VBoxContainer" parent="Layout/Content/Previews"]
layout_mode = 2
size_flags_horizontal = 3

[node name="SourceCaption" type="Label" parent="Layout/Content/Previews/SourceColumn"]
layout_mode = 2
text = "Source"

[node name="SourcePreview" type="TextureRect" parent="Layout/Content/Previews/SourceColumn"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 120)
layout_mode = 2
size_flags_vertical = 3
texture_filter = 1
expand_mode = 1
stretch_mode = 5

[node name="OutputColumn" type="VBoxContainer" parent="Layout/Content/Previews"]
layout_mode = 2
size_flags_horizontal = 3

[node name="OutputCaption" type="Label" parent="Layout/Content/Previews/OutputColumn"]
layout_mode = 2
text = "Packed result"

[node name="OutputPreview" type="TextureRect" parent="Layout/Content/Previews/OutputColumn"]
unique_name_in_owner = true
custom_minimum_size = Vector2(200, 120)
layout_mode = 2
size_flags_vertical = 3
texture_filter = 1
expand_mode = 1
stretch_mode = 5

[node name="Status" type="Label" parent="Layout/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
autowrap_mode = 3

[node name="Actions" type="HBoxContainer" parent="Layout/Content"]
layout_mode = 2

[node name="Spacer" type="Control" parent="Layout/Content/Actions"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Close" type="Button" parent="Layout/Content/Actions"]
layout_mode = 2
text = "Close"

[node name="Save" type="Button" parent="Layout/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Create and save…"

[node name="RefreshTimer" type="Timer" parent="."]
wait_time = 0.15
one_shot = true

[node name="SourceDialog" type="FileDialog" parent="."]
title = "Choose source texture"
file_mode = 0
access = 2
filters = PackedStringArray("*.png;PNG", "*.webp;WebP", "*.jpg,*.jpeg;JPEG")

[node name="SaveDialog" type="FileDialog" parent="."]
title = "Save texture"
file_mode = 4
access = 2

[connection signal="close_requested" from="." to="." method="hide"]
[connection signal="pressed" from="Layout/Content/SourceRow/Browse" to="." method="_choose_source"]
[connection signal="value_changed" from="Layout/Content/Fields/TileWidth" to="." method="_settings_changed"]
[connection signal="value_changed" from="Layout/Content/Fields/TileHeight" to="." method="_settings_changed"]
[connection signal="value_changed" from="Layout/Content/Fields/Gap" to="." method="_settings_changed"]
[connection signal="value_changed" from="Layout/Content/Fields/Margin" to="." method="_settings_changed"]
[connection signal="pressed" from="Layout/Content/Actions/Close" to="." method="hide"]
[connection signal="pressed" from="Layout/Content/Actions/Save" to="." method="_create_and_choose_path"]
[connection signal="timeout" from="RefreshTimer" to="." method="_refresh_preview"]
[connection signal="file_selected" from="SourceDialog" to="." method="_load_source"]
[connection signal="file_selected" from="SaveDialog" to="." method="_save_selected"]
[connection signal="canceled" from="SaveDialog" to="." method="_clear_pending"]
