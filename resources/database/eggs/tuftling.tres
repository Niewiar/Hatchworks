[gd_resource type="Resource" script_class="EggDefinition" format=3]
[ext_resource type="Script" path="res://code/database/EggDefinition.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/incubation/egg_model.tscn" id="model"]
[resource]
script = ExtResource("script")
id = &"tuftling_egg"
