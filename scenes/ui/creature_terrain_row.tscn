[gd_scene format=3]

[node name="CreatureTerrainRow" type="VBoxContainer"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="Icon" type="TextureRect" parent="Header"]
custom_minimum_size = Vector2(24,24)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
expand_mode = 1
stretch_mode = 5

[node name="Name" type="Label" parent="Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
text = "Grass"
autowrap_mode = 3

[node name="Share" type="Label" parent="Header"]
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "30% / min. 50%"
horizontal_alignment = 2

[node name="Progress" type="HBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Bar" type="ProgressBar" parent="Progress"]
custom_minimum_size = Vector2(0,14)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
mouse_filter = 2
show_percentage = false

[node name="Fulfillment" type="Label" parent="Progress"]
custom_minimum_size = Vector2(100,0)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
theme_override_font_sizes/font_size = 14
text = "60% fulfilled"
horizontal_alignment = 2
