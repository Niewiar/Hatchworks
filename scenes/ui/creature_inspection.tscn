[gd_scene format=3]

[ext_resource type="Script" path="res://code/ui/CreatureInspection.gd" id="script"]
[ext_resource type="PackedScene" path="res://scenes/ui/happiness_meter.tscn" id="happiness"]
[ext_resource type="PackedScene" path="res://scenes/ui/breeding_panel.tscn" id="breeding"]
[ext_resource type="PackedScene" path="res://scenes/ui/creature_factor_row.tscn" id="factor"]
