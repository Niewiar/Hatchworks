[node name="CreatureInspection" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 16
script = ExtResource("script")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 25
theme_type_variation = &"HeadingLabel"
text = "Tuftling"
autowrap_mode = 3

[node name="Sex" type="TextureRect" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(24,24)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 0
texture = ExtResource("male")
expand_mode = 1
stretch_mode = 5

[node name="Close" type="Button" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(32,32)
layout_mode = 2
size_flags_vertical = 4
text = "×"
theme_override_font_sizes/font_size = 22

[node name="Activity" type="HBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
mouse_filter = 0
theme_override_constants/separation = 8

